776558231},"auditionEpisode":{"episodeTitle":"个人展示课","episodeVideoUrl":"https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/83c106231397757896350610010/mGaI68S0ldMA.mp4?t=f2a4b300&us=4070880000&sign=b61f5d22a4afffc968ff80b47fb3c717"},"memberOfCPC":false,"tags":null},{"id":21796,"userId":58012018,"name":"御婕","brief":"粉笔事业单位公基法律A级讲师","desc":"粉笔事业单位公基法律A级讲师。\n\n法律专业本硕连读，11年一线教学授课经验，深耕公基、常识学科，线上线下授课服务几十万学员。长期研判全国事业单位统考、单招命题趋势，参与教研院讲义和教材编写，熟悉考情考点。授课逻辑清晰、直击考点，擅长化繁为简，助力学员短时间高效提分。\n\n亲自走过考场的人，才真正知道什么样的讲解对答题有用。这条路上的经验和教训，全部浓缩进了每一堂课里。","avatar":"19fffaa99ab9191.jpg","displayCoursePrefix":"sydw","teacherStat":{"teacherId":21796,"episodeCount":912,"scoreCount":39187,"avgScore":9.786817056676936,"fiveGradeAvgScore":4.89,"updateTime":1786766434461},"auditionEpisode":{"episodeTitle":"个人展示课","episodeVideoUrl":"https://vod.fbstatic.cn/22e9ceb2vodbj1251001446/3064134f1397757894301864710/70e5DqO0cxUA.mp4?t=f2a4b300&us=4070880000&sign=112efc407fbc891b6a6d01f0aa2a4407"},"memberOfCPC":false,"tags":null}],"lectureStat":{"lectureId":730790,"playStatus":1,"freeAddedStudentCount":0,"classMinutes":9090,"classStartTime":1751626800000,"classStopTime":1788269400000,"playProgress":0.5,"updateTime":1785829601839},"catIds":[],"teachChannel":1,"examType":0,"typeFlags":{"systemLecture":false,"interviewLecture":false,"writtenLecture":false,"writtenSmallClassLecture":false,"writtenOfflineLecture":false,"smallClassLecture":false},"examSeason":null,"needAgreement":false,"bestDiscount":{"id":327,"title":"0元-笔试会员优惠","tag":"笔试会员专享价","discountedPrice":0.0,"type":1,"showType":1},"discounts":[{"id":327,"title":"0元-笔试会员优惠","tag":"笔试会员专享价","discountedPrice":0.0,"type":1,"showType":1,"desc":"笔试会员优惠0元","userAvailable":true,"saleSlogan":"会员价仅需","icon":"https://ke.fbstatic.cn/api/images/16b06fafc9c177f.png","jumpPath":"/sydw/member/center","jumpSlogan":"了解会员"}],"buyLimit":null,"grouponRule":null,"apeCourseId":1,"tradeUnit":1,"distributionId":-1,"dealPlanId":0,"productType":{"type":0,"name":"专项课"},"contentHighlights":[{"